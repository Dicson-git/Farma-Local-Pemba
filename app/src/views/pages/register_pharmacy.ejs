<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="main-wrapper">
  <div class="auth-container">
    <div class="auth-header">
      <div style="margin-bottom:12px; color:var(--primary); display:flex; justify-content:center;">
        <svg class="ui-icon" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
          <line x1="12" y1="9" x2="12" y2="15"/>
          <line x1="9" y1="12" x2="15" y2="12"/>
        </svg>
      </div>
      <h1 class="auth-title">Cadastrar Farmácia no FarmaLocal</h1>
      <p class="auth-subtitle">
        Registe o seu estabelecimento para dar visibilidade aos medicamentos disponíveis no seu balcão e receber pacientes próximos.
      </p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error">
        <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/register" method="POST" id="registerPharmacyForm">
      <!-- Dados do Estabelecimento -->
      <div class="form-group">
        <label class="form-label" for="nome">Nome da Farmácia / Razão Social *</label>
        <input type="text" name="nome" id="nome" class="form-input" placeholder="Ex: Farmácia Central de Pemba" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="telefone">Telefone de Atendimento / WhatsApp *</label>
          <input type="tel" name="telefone" id="telefone" class="form-input" placeholder="+258 84 123 4567" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="horario_funcionamento">Horário de Atendimento</label>
          <input type="text" name="horario_funcionamento" id="horario_funcionamento" class="form-input" placeholder="Ex: 08h00 às 20h00" value="08h00 às 20h00">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="cidade">Cidade *</label>
          <input type="text" name="cidade" id="cidade" class="form-input" value="Pemba" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="bairro">Bairro *</label>
          <input type="text" name="bairro" id="bairro" class="form-input" placeholder="Ex: Natite, Baixa, Alto Gingone" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="endereco_detalhado">Ponto de Referência / Endereço Completo</label>
        <input type="text" name="endereco_detalhado" id="endereco_detalhado" class="form-input" placeholder="Ex: Próximo ao Mercado Municipal">
      </div>

      <!-- SEÇÃO EXCLUSIVA DE CAPTURA DE GPS DIRETO (SEM MAPA DE PINO) -->
      <div class="gps-capture-card">
        <h3 style="font-family:var(--font-heading); font-size:1.05rem; color:#1E3E6D; margin-bottom:6px; display:flex; align-items:center; justify-content:center; gap:6px;">
          <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
            <circle cx="12" cy="10" r="3"/>
          </svg>
          Localização Geográfica (GPS da Farmácia)
        </h3>
        <p style="font-size:0.84rem; color:#475569; margin-bottom:14px; max-width:480px; margin-left:auto; margin-right:auto;">
          Clique no botão abaixo estando no balcão da farmácia para capturar as coordenadas exatas do seu estabelecimento com 1 clique.
        </p>

        <button type="button" class="btn-gps-trigger" id="btnCapturePharmacyLocation" onclick="capturePharmacyGPS()">
          <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="22" y1="12" x2="18" y2="12"/>
            <line x1="6" y1="12" x2="2" y2="12"/>
            <line x1="12" y1="6" x2="12" y2="2"/>
            <line x1="12" y1="22" x2="12" y2="18"/>
          </svg>
          <span>Capturar Minha Localização GPS Atual</span>
        </button>

        <div id="gpsFeedback" class="gps-feedback" style="display:none;"></div>

        <div class="form-row" style="margin-top:14px; max-width:440px; margin-left:auto; margin-right:auto;">
          <div>
            <label class="form-label" style="font-size:0.75rem;">Latitude (GPS)</label>
            <input type="number" step="0.000001" name="latitude" id="latField" class="form-input" style="font-size:0.85rem; text-align:center; background:#F8FAFC;" value="-12.971500" required>
          </div>
          <div>
            <label class="form-label" style="font-size:0.75rem;">Longitude (GPS)</label>
            <input type="number" step="0.000001" name="longitude" id="lonField" class="form-input" style="font-size:0.85rem; text-align:center; background:#F8FAFC;" value="40.518000" required>
          </div>
        </div>
      </div>

      <!-- Credenciais de Acesso ao Painel -->
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="email">E-mail de Acesso *</label>
          <input type="email" name="email" id="email" class="form-input" placeholder="farmacia@exemplo.co.mz" required>
        </div>
        <div class="form-group">
          <label class="form-label" for="senha">Palavra-passe (Senha) *</label>
          <input type="password" name="senha" id="senha" class="form-input" placeholder="Mínimo 6 caracteres" required>
        </div>
      </div>

      <button type="submit" class="btn-gps-action" style="width:100%; margin-top:10px;">
        <span>Finalizar Cadastro e Aceder ao Painel</span>
      </button>

      <p style="text-align:center; font-size:0.85rem; color:#64748B; margin-top:18px;">
        Já possui uma conta? <a href="/login" style="color:#2563EB; font-weight:600;">Entrar no Painel</a>
      </p>
    </form>
  </div>
</main>

<script>
  function capturePharmacyGPS() {
    const feedback = document.getElementById('gpsFeedback');
    const btn = document.getElementById('btnCapturePharmacyLocation');

    if (!navigator.geolocation) {
      alert('Seu navegador não possui suporte a geolocalização nativa.');
      return;
    }

    btn.disabled = true;
    btn.innerHTML = '<span>A capturar coordenadas do sensor GPS...</span>';
    feedback.style.display = 'block';
    feedback.style.color = '#2563EB';
    feedback.innerText = 'Acedendo aos sensores físicos do dispositivo...';

    navigator.geolocation.getCurrentPosition(
      (pos) => {
        const lat = pos.coords.latitude.toFixed(6);
        const lon = pos.coords.longitude.toFixed(6);
        const acc = Math.round(pos.coords.accuracy);

        document.getElementById('latField').value = lat;
        document.getElementById('lonField').value = lon;

        btn.disabled = false;
        btn.innerHTML = `
          <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
          <span>GPS Capturado com Sucesso!</span>
        `;
        btn.style.background = '#10B981';

        feedback.style.color = '#166534';
        feedback.innerHTML = `Localização confirmada! Precisão aproximada: ±${acc} metros (Lat: ${lat}, Lon: ${lon})`;
      },
      (err) => {
        console.error('Erro GPS:', err);
        btn.disabled = false;
        btn.innerHTML = `
          <svg class="ui-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          <span>Tentar Novamente</span>
        `;
        feedback.style.color = '#DC2626';
        feedback.innerText = 'Não foi possível ler o GPS. Certifique-se de autorizar a permissão de localização no navegador.';
      },
      { enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }
    );
  }
</script>

<%- include('../partials/footer') %>
